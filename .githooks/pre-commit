#!/bin/bash
# .githooks/pre-commit — SEC-003 密钥扫描钩子（任务书 #17）
# 扫描暂存区文件内容，命中密钥特征即拒绝提交并打印文件名。
# 本脚本自身不含任何真实密钥。
# 白名单：.githooks/secret-allowlist 逐行精确路径（# 起为注释）；
#         *.example/*.sample/*.template 与 .githooks/ 自身自动放行。

set -u

ALLOWLIST=".githooks/secret-allowlist"

is_allowed() {
  case "$1" in
    .githooks/*|*.example|*.sample|*.template) return 0 ;;
  esac
  [ -f "$ALLOWLIST" ] || return 1
  while IFS= read -r line; do
    line="${line%%#*}"
    line="${line//[[:space:]]/}"
    [ -n "$line" ] && [ "$1" = "$line" ] && return 0
  done < "$ALLOWLIST"
  return 1
}

offenders=""
while IFS= read -r f; do
  [ -z "$f" ] && continue
  is_allowed "$f" && continue
  content=$(git show ":$f" 2>/dev/null) || continue
  hit=""
  # 1) Supabase JWT（eyJ 开头的三段式长串）
  if printf '%s' "$content" | grep -Eq 'eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{5,}'; then
    hit="Supabase JWT"
  # 2) 密钥环境变量带实值（占位符 your-/xxx/example 等不算）
  elif printf '%s' "$content" | grep -Eio '(SUPABASE_SERVICE_ROLE_KEY|WCL_CLIENT_SECRET|JWT_SECRET)[[:space:]]*=[[:space:]]*["'"'"']?[A-Za-z0-9_.+/=-]{8,}' \
       | grep -Eiv '(your[-_ ]|xxx|changeme|placeholder|example|sample)' | grep -q .; then
    hit="密钥环境变量实值"
  # 3) 带密码的 postgres 连接串（user:password@ 等占位符不算）
  elif printf '%s' "$content" | grep -Eio 'postgres(ql)?://[^:/[:space:]]+:[^@[:space:]]+@' \
       | grep -Eiv ':(password|pass|pwd|xxx|changeme|placeholder|example|sample)@' | grep -q .; then
    hit="带密码的 postgres 连接串"
  fi
  if [ -n "$hit" ]; then
    offenders="$offenders  $f  （命中：$hit）\n"
  fi
done <<EOF
$(git diff --cached --name-only --diff-filter=ACMR)
EOF

if [ -n "$offenders" ]; then
  echo "❌ pre-commit 密钥扫描拦截：以下暂存文件疑似包含密钥，已拒绝提交：" >&2
  printf '%b' "$offenders" >&2
  echo "如确属示例/占位内容，请将文件路径加入 $ALLOWLIST 后重试。" >&2
  exit 1
fi
exit 0
